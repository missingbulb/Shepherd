{
  "version": 1,
  "tasks": {
    "basics/ci-performance": {
      "path": ".claudinite/shared/packs/basics/tasks/ci-performance/task.json",
      "declaration": {
        "id": "ci-performance",
        "description": "Reads where this repository's CI time goes from the Actions run history, keeps a standing record of each workflow's median, and hands an agent a real regression already localised to a workflow and a before-and-after delta.",
        "trigger": "schedule",
        "preconditions": [
          "schedule:at-most-weekly",
          "substantive-change || prs-touched",
          "last-run-not-parked"
        ],
        "expected_outcome": "fresh_pr",
        "automerge": "anything",
        "code_worker_mjs": "worker.mjs",
        "code_work_timeout": 300,
        "agent_model": "sonnet",
        "agent_instructions": "task.md",
        "agent_execution_timeout": 3600
      }
    },
    "basics/improve-comments": {
      "path": ".claudinite/shared/packs/basics/tasks/improve-comments/task.json",
      "declaration": {
        "id": "improve-comments",
        "description": "Reads a slice of the repository's code as comments, deletes the ones that restate the code, corrects the ones that drifted, and adds the why only a reader's guess carried.",
        "trigger": "schedule",
        "preconditions": [
          "schedule:at-most-weekly",
          "substantive-change",
          "commits-outside:.claudinite/shared/"
        ],
        "expected_outcome": "amend_existing_or_create_new_pr",
        "automerge": [
          "comment-only-changes",
          "readme-changes"
        ],
        "agent_model": "opus",
        "agent_instructions": "task.md",
        "agent_execution_timeout": 1800
      }
    },
    "claudinite/adopt-requested-packs": {
      "path": ".claudinite/temp/packs/claudinite/tasks/adopt-requested-packs/task.json",
      "declaration": {
        "id": "adopt-requested-packs",
        "description": "The member half of the fleet fan-out: adopts the packs an add-packs work list asks for, in this repository, by this repository's own agent.",
        "trigger": "request",
        "expected_outcome": "fresh_pr",
        "automerge": [
          "claudinite-shared-packs",
          "claudinite-settings-updates",
          "generated-file-changes"
        ],
        "agent_model": "sonnet",
        "agent_instructions": "task.md",
        "agent_execution_timeout": 3600
      }
    },
    "claudinite/growth-dedup": {
      "path": ".claudinite/temp/packs/claudinite/tasks/growth-dedup/task.json",
      "declaration": {
        "id": "growth-dedup",
        "description": "The growth lifecycle's pruning stage: reconciles this repository's local packs against the canon it mounts, removing local items the canon now covers and keeping those the canon states too generally.",
        "trigger": "schedule",
        "preconditions": [
          "schedule:at-most-weekly",
          "mount-moved || commits-under:.claudinite/local"
        ],
        "expected_outcome": "supersede_existing_pr",
        "automerge": [
          "under:.claudinite/local"
        ],
        "code_worker_mjs": "worker.mjs",
        "code_work_timeout": 600,
        "agent_model": "opus",
        "agent_instructions": "task.md",
        "agent_execution_timeout": 1800
      }
    },
    "claudinite/growth-extract": {
      "path": ".claudinite/temp/packs/claudinite/tasks/growth-extract/task.json",
      "declaration": {
        "id": "growth-extract",
        "description": "The growth lifecycle's capture stage: mines the window's repository activity and the captured conversation logs for durable lessons, folds them into this repository's local packs, and runs prose-to-checks over what it wrote.",
        "schedule_after": [
          "engine/update"
        ],
        "trigger": "schedule",
        "preconditions": [
          "schedule:at-most-daily",
          "substantive-change"
        ],
        "expected_outcome": "amend_existing_or_create_new_pr",
        "automerge": [
          "under:.claudinite/local"
        ],
        "agent_model": "opus",
        "agent_instructions": "task.md",
        "agent_execution_timeout": 2700
      }
    },
    "claudinite/prose-to-checks-sweep": {
      "path": ".claudinite/temp/packs/claudinite/tasks/prose-to-checks-sweep/task.json",
      "declaration": {
        "id": "prose-to-checks-sweep",
        "description": "Mines this repository's existing pack prose for always-testable rules the conversion missed and converts the strongest ones into checks.",
        "trigger": "schedule",
        "preconditions": [
          "schedule:at-most-weekly",
          "repo-active"
        ],
        "expected_outcome": "amend_existing_or_create_new_pr",
        "automerge": [
          "under:.claudinite/local"
        ],
        "agent_model": "opus",
        "agent_instructions": "task.md",
        "agent_execution_timeout": 2700
      }
    },
    "claudinite/rule-revalidation": {
      "path": ".claudinite/temp/packs/claudinite/tasks/rule-revalidation/task.json",
      "declaration": {
        "id": "rule-revalidation",
        "description": "Re-probes the pack rules whose truth lives outside this repository, such as what the harness rejects or which tools exist, and corrects the ones the platform has moved under.",
        "trigger": "schedule",
        "preconditions": [
          "schedule:at-most-weekly",
          "repo-active"
        ],
        "expected_outcome": "supersede_existing_pr",
        "automerge": [
          "under:.claudinite/local"
        ],
        "agent_model": "opus",
        "agent_instructions": "task.md",
        "agent_execution_timeout": 2700
      }
    },
    "claudinite/usage-review": {
      "path": ".claudinite/temp/packs/claudinite/tasks/usage-review/task.json",
      "declaration": {
        "id": "usage-review",
        "description": "Compares what each skill declares about its own usage against what the record shows, by a file of readable rule declarations, and writes the findings with their causes and recommendations. Changes nothing it reviews.",
        "schedule_after": [
          "engine/usage-fold"
        ],
        "trigger": "schedule",
        "preconditions": [
          "schedule:at-most-daily",
          "fold-moved-since-review",
          "window-has-sessions:10"
        ],
        "expected_outcome": "amend_existing_or_create_new_pr",
        "automerge": "nothing",
        "code_worker_mjs": "worker.mjs",
        "code_work_timeout": 900
      }
    },
    "claudinite/usage-triage": {
      "path": ".claudinite/temp/packs/claudinite/tasks/usage-triage/task.json",
      "declaration": {
        "id": "usage-triage",
        "description": "Turns a usage-review finding that has stood two weeks into a proposed change to this repo's own local packs - the edit itself, one pull request per subject, for the owner to merge or decline.",
        "trigger": "schedule",
        "preconditions": [
          "schedule:at-most-weekly",
          "lasting-usage-finding"
        ],
        "expected_outcome": "fresh_pr",
        "automerge": "nothing",
        "agent_model": "opus",
        "agent_instructions": "task.md",
        "agent_execution_timeout": 2700
      }
    },
    "fleet-github/actions-storage-forecast": {
      "path": ".claudinite/shared/packs/fleet-github/tasks/actions-storage-forecast/task.json",
      "declaration": {
        "id": "actions-storage-forecast",
        "description": "Forecasts whether the account owning this fleet will exhaust its included Actions storage before the month ends, from its plan's published allowance and its billing usage report, and keeps one issue open with the forecast and the repositories driving it while it would.",
        "trigger": "schedule",
        "preconditions": [
          "schedule:at-most-daily",
          "last-run-not-parked"
        ],
        "expected_outcome": "no_code_changes",
        "code_worker_mjs": "worker.mjs",
        "code_work_timeout": 300,
        "code_work_required_secrets": [
          "FLEET_GITHUB_TOKEN"
        ],
        "agent_model": "none"
      }
    },
    "fleet/canon-prose-to-checks": {
      "path": ".claudinite/temp/packs/fleet/tasks/canon-prose-to-checks/task.json",
      "declaration": {
        "id": "canon-prose-to-checks",
        "description": "Mines the shelf's own pack prose for always-testable rules the conversion missed and converts the strongest ones, so a rule every member pays context for becomes a check instead.",
        "trigger": "schedule",
        "preconditions": [
          "schedule:at-most-weekly",
          "repo-active"
        ],
        "expected_outcome": "amend_existing_or_create_new_pr",
        "automerge": [
          "under:packs"
        ],
        "agent_model": "opus",
        "agent_instructions": "task.md",
        "agent_execution_timeout": 2700
      }
    },
    "fleet/canon-rule-revalidation": {
      "path": ".claudinite/temp/packs/fleet/tasks/canon-rule-revalidation/task.json",
      "declaration": {
        "id": "canon-rule-revalidation",
        "description": "Re-probes the shelf's rules whose truth lives outside this repository, such as what the harness rejects or which tools exist, and corrects the ones the platform has moved under.",
        "trigger": "schedule",
        "preconditions": [
          "schedule:at-most-weekly"
        ],
        "expected_outcome": "amend_existing_or_create_new_pr",
        "automerge": [
          "under:packs"
        ],
        "agent_model": "opus",
        "agent_instructions": "task.md",
        "agent_execution_timeout": 2700
      }
    },
    "fleet/fleet-add-missing-packs": {
      "path": ".claudinite/temp/packs/fleet/tasks/fleet-add-missing-packs/task.json",
      "declaration": {
        "id": "fleet-add-missing-packs",
        "description": "The fleet enforcer for pack coverage: scans covered members for packs their repository shape calls for but they do not declare, and files each such member an add-packs work list that its own adoption task acts on.",
        "trigger": "schedule",
        "preconditions": [
          "schedule:at-most-weekly"
        ],
        "expected_outcome": "no_code_changes",
        "code_work": "cn fleet add-packs --scan-for-needed-packs=true --repos=all-covered-members",
        "code_work_timeout": 900,
        "code_work_required_secrets": [
          "FLEET_GITHUB_TOKEN"
        ]
      }
    },
    "fleet/fleet-directory": {
      "path": ".claudinite/temp/packs/fleet/tasks/fleet-directory/task.json",
      "declaration": {
        "id": "fleet-directory",
        "description": "Signs and publishes this fleet's directory, the global versions it approves, its blocked list and its own packs from packs/, to the claudinite-fleet branch its members read; daily, and again when the shelf's catalog moves.",
        "trigger": "schedule",
        "preconditions": [
          "schedule:at-most-daily || shelf-catalog-moved"
        ],
        "expected_outcome": "no_code_changes",
        "code_work": "cn fleet directory",
        "code_work_timeout": 900,
        "code_work_required_secrets": [
          "FLEET_GITHUB_TOKEN",
          "FLEET_SIGNING_KEY"
        ]
      }
    },
    "fleet/fleet-issues": {
      "path": ".claudinite/temp/packs/fleet/tasks/fleet-issues/task.json",
      "declaration": {
        "id": "fleet-issues",
        "description": "Reads every open issue in every repository under the owner over the fleet token, never a body or a pull request, and lands them as one file, .claudinite/fleet/issues.GENERATED.json, on one accumulating pull request, so a session can triage the fleet from a single local read.",
        "trigger": "schedule",
        "preconditions": [
          "schedule:at-most-daily"
        ],
        "expected_outcome": "amend_existing_or_create_new_pr",
        "automerge": [
          "fleet-issues-artifact"
        ],
        "code_work": "cn fleet issues",
        "code_work_timeout": 600,
        "code_work_required_secrets": [
          "FLEET_GITHUB_TOKEN"
        ]
      }
    },
    "fleet/fleet-key-create": {
      "path": ".claudinite/temp/packs/fleet/tasks/fleet-key-create/task.json",
      "declaration": {
        "id": "fleet-key-create",
        "description": "Creates this fleet's signing key: its private half sealed into the Actions secret FLEET_SIGNING_KEY, its public half proposed to the claudinite-fleet-key branch in a pull request the approvers merge.",
        "trigger": "request",
        "expected_outcome": "no_code_changes",
        "code_work": "cn fleet key create",
        "code_work_timeout": 300,
        "code_work_required_secrets": [
          "FLEET_GITHUB_TOKEN"
        ]
      }
    },
    "fleet/fleet-key-rotate": {
      "path": ".claudinite/temp/packs/fleet/tasks/fleet-key-rotate/task.json",
      "declaration": {
        "id": "fleet-key-rotate",
        "description": "Replaces this fleet's signing key: a new key into FLEET_SIGNING_KEY and its public half proposed beside the old one; the old one is retired once a directory signed by the new key is published.",
        "trigger": "request",
        "expected_outcome": "no_code_changes",
        "code_work": "cn fleet key rotate",
        "code_work_timeout": 300,
        "code_work_required_secrets": [
          "FLEET_GITHUB_TOKEN"
        ]
      }
    },
    "fleet/fleet-pack-seeds": {
      "path": ".claudinite/temp/packs/fleet/tasks/fleet-pack-seeds/task.json",
      "declaration": {
        "id": "fleet-pack-seeds",
        "description": "Reports, for every member, which of the packs this fleet standardises on it does not declare, and keeps this repo's mirror of the shelf level; it writes nothing into any member.",
        "trigger": "schedule",
        "preconditions": [
          "schedule:at-most-daily"
        ],
        "expected_outcome": "no_code_changes",
        "code_work": "cn fleet pack-seeds",
        "code_work_timeout": 900,
        "code_work_required_secrets": [
          "FLEET_GITHUB_TOKEN"
        ]
      }
    },
    "fleet/fleet-roster": {
      "path": ".claudinite/temp/packs/fleet/tasks/fleet-roster/task.json",
      "declaration": {
        "id": "fleet-roster",
        "description": "Walks every repository under the owner over the fleet token, builds the roster of members and non-members, reports the repositories outside the fleet, and lands the roster artifact .claudinite/fleet/roster.GENERATED.json, one verdict per repository, on one accumulating pull request.",
        "trigger": "schedule",
        "preconditions": [
          "schedule:at-most-daily"
        ],
        "expected_outcome": "amend_existing_or_create_new_pr",
        "automerge": [
          "fleet-roster-artifact"
        ],
        "code_work": "cn fleet roster",
        "code_work_timeout": 900,
        "code_work_required_secrets": [
          "FLEET_GITHUB_TOKEN"
        ]
      }
    },
    "fleet/fleet-update": {
      "path": ".claudinite/temp/packs/fleet/tasks/fleet-update/task.json",
      "declaration": {
        "id": "fleet-update",
        "description": "The operator's lever to force every member, or a named few, to update to the published engine and pack versions now rather than on its own schedule.",
        "trigger": "request",
        "expected_outcome": "no_code_changes",
        "code_work": "cn fleet update",
        "code_work_timeout": 1800,
        "code_work_required_secrets": [
          "FLEET_GITHUB_TOKEN"
        ]
      }
    },
    "fleet/growth-discover-packs": {
      "path": ".claudinite/temp/packs/fleet/tasks/growth-discover-packs/task.json",
      "declaration": {
        "id": "growth-discover-packs",
        "description": "The fleet sweep for technologies the canon's shelf does not yet home: reads what every member is built on, subtracts what the shelf covers, and opens a reviewed pull request authoring the missing pack. The only stage anywhere that mints a pack.",
        "trigger": "schedule",
        "preconditions": [
          "schedule:at-most-weekly"
        ],
        "expected_outcome": "fresh_pr",
        "automerge": "nothing",
        "invocation_endpoint": "fleet",
        "agent_model": "opus",
        "agent_instructions": "task.md",
        "agent_execution_timeout": 3600
      }
    },
    "fleet/growth-promote": {
      "path": ".claudinite/temp/packs/fleet/tasks/growth-promote/task.json",
      "declaration": {
        "id": "growth-promote",
        "description": "The growth lifecycle's central stage: reads the participating members' merged local-pack lessons, generalises the portable ones, and opens an owner-gated pull request against the canon.",
        "schedule_after": [
          "claudinite/growth-extract"
        ],
        "trigger": "schedule",
        "preconditions": [
          "schedule:at-most-daily",
          "fleet-local-packs-changed"
        ],
        "expected_outcome": "amend_existing_or_create_new_pr",
        "automerge": "nothing",
        "invocation_endpoint": "fleet",
        "agent_model": "opus",
        "agent_instructions": "task.md",
        "agent_execution_timeout": 2700
      }
    },
    "fleet/pack-version-history": {
      "path": ".claudinite/temp/packs/fleet/tasks/pack-version-history/task.json",
      "declaration": {
        "id": "pack-version-history",
        "description": "Retraces from the base branch's history which pull requests each pack version shipped and writes the rows its VERSIONS.md is missing, so the record of what a version changed is derived from git rather than maintained by hand in every pull request.",
        "trigger": "schedule",
        "preconditions": [
          "schedule:at-most-weekly",
          "commits-under:packs"
        ],
        "expected_outcome": "supersede_existing_pr",
        "automerge": [
          "pack-version-history"
        ],
        "code_worker_mjs": "worker.mjs",
        "code_work_timeout": 600
      }
    },
    "fleet/revalidate-from-source": {
      "path": ".claudinite/temp/packs/fleet/tasks/revalidate-from-source/task.json",
      "declaration": {
        "id": "revalidate-from-source",
        "description": "Keeps the shelf current with the technologies its packs teach: reads each pack's declared upstream sources, changes pack content that has been dated, and advances the reconciliation anchors through an owner-approved pull request.",
        "trigger": "schedule",
        "preconditions": [
          "schedule:at-most-monthly"
        ],
        "expected_outcome": "supersede_existing_pr",
        "automerge": [
          "under:packs && doc-changes"
        ],
        "agent_model": "opus",
        "agent_instructions": "task.md",
        "agent_execution_timeout": 2700
      }
    },
    "fleet/usage-triage": {
      "path": ".claudinite/temp/packs/fleet/tasks/usage-triage/task.json",
      "declaration": {
        "id": "usage-triage",
        "description": "Turns a usage-review finding that has stood two weeks into a proposed change to the shelf - the edit itself, one pull request per subject, for the owner to merge or decline.",
        "trigger": "schedule",
        "preconditions": [
          "schedule:at-most-weekly",
          "lasting-usage-finding"
        ],
        "expected_outcome": "fresh_pr",
        "automerge": "nothing",
        "agent_model": "opus",
        "agent_instructions": "task.md",
        "agent_execution_timeout": 2700
      }
    }
  }
}
